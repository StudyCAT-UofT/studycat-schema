generator client {
    provider = "prisma-client-js"
}

generator py {
    provider             = "prisma-client-py"
    recursive_type_depth = 5
}

datasource db {
    provider = "sqlserver"
    url      = env("DATABASE_URL")
}

//
// ========== Core Auth & Roster ==========
//

model User {
    id         String   @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    username   String   @unique
    givenName  String   @default("")
    familyName String   @default("")
    createdAt  DateTime @default(now())
    isAdmin    Boolean  @default(false)

    // Relations
    enrollments Enrollment[]
    quizzes     Quiz[]       @relation("QuizCreatedBy")
}

model Course {
    id        String   @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    code      String
    title     String
    createdAt DateTime @default(now())

    // Relations
    offerings CourseOffering[]
    items     Item[]

    @@unique([code, title])
}

model Term {
    id        String    @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    name      String // e.g., "Fall 2025"
    startDate DateTime?
    endDate   DateTime?

    // Relations
    offerings CourseOffering[]

    @@unique([name])
}

model CourseOffering {
    id       String  @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    courseId String  @db.UniqueIdentifier
    termId   String  @db.UniqueIdentifier 
    display  String?

    createdAt DateTime @default(now())

    // Relations
    course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
    term    Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
    enrolls Enrollment[]
    quizzes Quiz[]
    modules Module[]

    @@unique([courseId, termId])
    @@index([termId])
    @@index([courseId])
}

model Enrollment {
    id           String       @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    userId       String       @db.UniqueIdentifier
    offeringId   String       @db.UniqueIdentifier
    // Role at offering-level (can mirror the global role; useful if you later diverge)
    offeringRole String       @default("STUDENT")
    createdAt    DateTime     @default(now())
    hidden       Boolean      @default(false)

    // Relations
    user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    thetas   Theta[]
    Attempt  Attempt[]

    @@unique([userId, offeringId])
    @@index([offeringId])
    @@index([offeringRole])
}

//
// ========== Modules (per Course Offering) ==========
//

model Module {
    id         String @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    offeringId String @db.UniqueIdentifier
    name       String // Module name (e.g., "Module 1: Introduction")

    createdAt DateTime @default(now())

    // Relations
    offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    items    Item[]
    thetas   Theta[]
    quizModules QuizModule[]

    @@unique([offeringId, name]) // Unique per offering
    @@index([offeringId])
}

//
// ========== Theta (User Ability per Module) ==========
//

model Theta {
    id           String @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    enrollmentId String @db.UniqueIdentifier
    moduleId     String @db.UniqueIdentifier
    value        Float // Theta value

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
    module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

    @@unique([enrollmentId, moduleId]) // One theta per enrollment-module pair
    @@index([enrollmentId])
    @@index([moduleId])
}

//
// ========== Item Bank (per Course) ==========
// Imported from spreadsheet: 
// Module, Question_ID, Bloom_Cat, Stem, Reference, Response_A..D, Justification_A..D,
// Figure, PtBi, Average, Attempts, IRT_a, IRT_b, IRT_c
//

model Item {
    id                 String        @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    courseId           String        @db.UniqueIdentifier
    moduleId           String        @db.UniqueIdentifier
    externalQuestionId String // Spreadsheet "Question_ID" (stable within a course)
    bloom              String // Standardized from spreadsheet Bloom_Cat
    stem               String // Rich text/markdown-safe; plain string in MVP
    reference          String? // Spreadsheet "Reference"
    figureUrl          String? // Spreadsheet "Figure" (URL)
    ptBi               Float? // Spreadsheet "PtBi"
    average            Float? // Spreadsheet "Average"
    attemptsCount      Int? // Spreadsheet "Attempts"

    // IRT params (3PL)
    irtA Float // Spreadsheet "IRT_a"
    irtB Float // Spreadsheet "IRT_b"
    irtC Float // Spreadsheet "IRT_c"

    // Operational
    active    Boolean  @default(true)
    createdAt DateTime @default(now())

    // Relations
    course    Course       @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    module    Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
    options   ItemOption[]
    quizLinks QuizItem[] // Explicit includes to quizzes
    responses Response[]

    @@unique([courseId, externalQuestionId]) // Stable per course
    @@index([courseId])
    @@index([moduleId])
    @@index([bloom])
    @@index([active])
}

model ItemOption {
    id            String      @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    itemId        String      @db.UniqueIdentifier
    label         String  // A, B, C, D
    text          String // Spreadsheet "Response_X"
    justification String? // Spreadsheet "Justification_X"
    isCorrect     Boolean // Derived from bolded cell in sheet during import

    // Relations
    item     Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
    Response Response[]

    @@unique([itemId, label])
    @@index([isCorrect])
}

//
// ========== Quizzes (per Offering) ==========
// Instructor-created; fixed length; students can attempt unlimited times.
// Scope can be defined both by filters (modules/blooms) and explicit item selection.
//

model Quiz {
    id          String  @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    offeringId  String  @db.UniqueIdentifier
    title       String
    fixedLength Int // N items per attempt
    active      Boolean @default(true)
    feedbackVisibility String @default("full")
    shuffled    Boolean @default(false)

    // Filter-based scope (optional). Explicit selection via QuizItem is also supported.
    includedBlooms    String          @default("")

    // Audit
    createdById String?  @db.UniqueIdentifier
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    offering  CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
    createdBy User?          @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
    quizItems QuizItem[]
    attempts  Attempt[]
    quizModules QuizModule[]

    @@index([offeringId])
    @@index([active])
}

model QuizItem {
    // Explicit include of particular items into a quiz scope
    quizId String  @db.UniqueIdentifier
    itemId String  @db.UniqueIdentifier

    quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
    item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

    @@id([quizId, itemId])
    @@index([itemId])
}

model QuizModule {
    quizId String    @db.UniqueIdentifier
    moduleId String  @db.UniqueIdentifier

    // Theta value that is considered 'mastery'
    masteryThreshold Float 

    quiz Quiz @relation(fields: [quizId], references: [id])
    module Module @relation(fields: [moduleId], references: [id])

    @@id([quizId, moduleId])
}

//
// ========== Attempts & Responses ==========
// Unlimited attempts, autosave, per-response timing, correctness, engine snapshots.
//

model Attempt {
    id           String        @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    quizId       String        @db.UniqueIdentifier
    enrollmentId String        @db.UniqueIdentifier
    startedAt    DateTime      @default(now())
    finishedAt   DateTime?
    status       String        @default("IN_PROGRESS")

    // Copy of quiz length at start for audit
    fixedLengthN Int

    // Engine metadata and audit
    engineVersion         String? // Provided by engine or set by integrator
    // Snapshot of eligible items the client computed at start (IDs & filters)
    scopeSnapshot         String? // {includedModules, includedBlooms, eligibleItemIds: [...]}
    // Final mastery vector returned by engine (per-module) at finish (optional)
    engineMasteryAtFinish String?

    // Relations
    quiz       Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
    enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
    responses  Response[]

    @@index([quizId])
    @@index([enrollmentId])
    @@index([status])
    @@index([startedAt])
}

model Response {
    id            String      @id @db.UniqueIdentifier @default(dbgenerated("NEWID()"))
    attemptId     String      @db.UniqueIdentifier
    itemId        String      @db.UniqueIdentifier
    // Selected option (redundant to itemOptionId for fast analytics & robustness)
    selectedLabel String 
    itemOptionId  String?     @db.UniqueIdentifier // The actual ItemOption chosen (if you want FK safety)

    isCorrect      Boolean
    askedAt        DateTime // When question was shown
    answeredAt     DateTime // When answer was submitted
    responseTimeMs Int // Convenience: answeredAt - askedAt in ms

    // Optional mastery vector snapshot (per-module) after *this* response
    engineMasterySnapshot String?

    // Relations
    attempt    Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
    item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
    itemOption ItemOption? @relation(fields: [itemOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@index([attemptId])
    @@index([itemId])
    @@index([isCorrect])
    @@index([answeredAt])
}
